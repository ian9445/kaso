# ===========================================================
# KASO 環境變數範本
# ===========================================================
# 用法：複製這個檔成 .env，把值填進去。
#       .env 已被 .gitignore 擋住，不會推上 GitHub。
#
# ⚠️ 真正的金鑰永遠不要寫進這個檔案，這份只放範例值。
# ===========================================================


# -----------------------------------------------------------
# 1. AI 助手 — Hermes Agent（本機 API server）
# -----------------------------------------------------------
# 設定位置其實在 ~/.hermes/.env，這裡只是給後端知道要打哪裡。
#
# 啟用步驟：
#   1) 在 ~/.hermes/.env 寫入：
#        API_SERVER_ENABLED=true
#        API_SERVER_KEY=<跟下面 HERMES_API_KEY 一樣的值>
#        API_SERVER_CORS_ORIGINS=http://localhost:3000
#   2) 執行 hermes gateway
#   3) 會看到 [API Server] listening on http://127.0.0.1:8642

HERMES_BASE_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=change-me-local-dev
HERMES_MODEL=hermes-agent


# -----------------------------------------------------------
# 2. 備援 / 上線用 — Nous Portal（雲端，不用自己跑機器）
# -----------------------------------------------------------
# 如果 demo 當下 hermes gateway 沒開，或之後要上線，可以切到這個。
# 兩者都是 OpenAI 相容格式，只要換 BASE_URL 與 KEY。
# 金鑰在 https://portal.nousresearch.com 產生，格式 sk-nous-xxxx

NOUS_BASE_URL=https://inference-api.nousresearch.com/v1
NOUS_API_KEY=sk-nous-xxxxxxxxxxxxxxxx
NOUS_MODEL=Hermes-4-70B


# -----------------------------------------------------------
# 3. 附近優惠 — Google Places API（解決假地址問題）
# -----------------------------------------------------------
# 申請：https://console.cloud.google.com
#   1) 建立專案 → 啟用「Places API (New)」
#   2) 憑證 → 建立 API 金鑰
#   3) ⚠️ 一定要設限制：
#        應用程式限制 → HTTP 參照網址 → 填你的網域
#        API 限制 → 只勾 Places API
#   4) 需要綁定計費帳戶（即使在免費額度內也要綁）
#
# 額度：Nearby Search 屬 Pro 級距，每月免費 5,000 次，
#       超過每 1,000 次 US$32。demo 期間打個位數次就夠。

GOOGLE_MAPS_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GOOGLE_PLACES_RADIUS=1000
GOOGLE_PLACES_CENTER=25.0478,121.5170


# -----------------------------------------------------------
# 4. 商品比價 — BigGo（可選，目前用靜態資料）
# -----------------------------------------------------------
# 一般商品搜尋(product_search)與價格歷史「不需要」憑證，
# 只有規格搜尋(spec_search)才需要。
#
# 取得（免費）：
#   1) 註冊 BigGo 帳號
#   2) https://account.biggo.com/setting/token
#   3) 按「Generate certification」，複製 client_id / client_secret
#
# 注意：BigGo 提供的是 MCP Server（Python 程序），不是 REST API。
#       本機起 SSE 模式：
#         BIGGO_MCP_SERVER_REGION=TW \
#         BIGGO_MCP_SERVER_SERVER_TYPE=sse \
#         uvx BigGo-MCP-Server@latest
#       → http://localhost:9876/sse

BIGGO_CLIENT_ID=
BIGGO_CLIENT_SECRET=
BIGGO_REGION=TW
BIGGO_SSE_URL=http://localhost:9876/sse


# -----------------------------------------------------------
# 5. 資料來源開關
# -----------------------------------------------------------
# 沒接真實來源時保持 demo，介面不會壞，只是回靜態資料。
# 接好一項就把那一項改成 live。

DATA_MODE_SEARCH=demo     # demo | live
DATA_MODE_NEARBY=demo     # demo | live
DATA_MODE_CHAT=demo       # demo | live
