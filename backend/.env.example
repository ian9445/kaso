# 複製這個檔案為 .env，把下面換成你自己的 Anthropic API key。
# 拿 key 的地方：https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# 選填，預設 claude-sonnet-5。想省錢可以改 claude-haiku-4-5-20251001。
ANTHROPIC_MODEL=claude-sonnet-5

# 附近優惠地圖用。去 https://console.cloud.google.com/google/maps-apis 開一個專案、
# 啟用「Maps JavaScript API」、開 billing（有 $200/月免費額度）、建立 API key。
# 這個 key 設計上就是給瀏覽器用的，正式上線記得在 GCP 主控台限制 HTTP referrer。
GOOGLE_MAPS_API_KEY=
